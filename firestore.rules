rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isShopOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    function isValidReservationUpdate() {
      return request.resource.data.stock == resource.data.stock &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reservations', 'updatedAt']) &&
             request.resource.data.reservations is map &&
             request.resource.data.reservations.keys().size() <= 100;
    }

    function isValidCouponReservationUpdate() {
      return request.resource.data.usedCount == resource.data.usedCount &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reservations', 'updatedAt']) &&
             request.resource.data.reservations is map &&
             request.resource.data.reservations.keys().size() <= 100;
    }

    // ตรวจว่าคูปองที่แนบกับออเดอร์ถูกจองใน transaction เดียวกัน และส่วนลดไม่เกินที่คูปองให้ได้
    function isValidOrderCoupon(orderId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/coupons/$(data.couponCode);
      let before = get(path).data;
      let after = getAfter(path).data;
      return data.couponCode is string &&
             data.couponCode.matches('[A-Z0-9_-]{3,20}') &&
             before.ownerId == data.ownerId &&
             before.isActive == true &&
             (before.get('expiresAt', null) == null || before.expiresAt > request.time) &&
             data.subtotal >= before.get('minOrderAmount', 0) &&
             data.discountAmount > 0 &&
             data.discountAmount <= (before.discountType == 'percent'
               ? data.subtotal * before.discountValue / 100 + 0.01
               : before.discountValue + 0.01) &&
             after.reservations[orderId].customerId == request.auth.uid &&
             after.usedCount == before.usedCount;
    }

    function isValidReservationOrder(orderId) {
      let data = request.resource.data;
      return data.status == 'รอชำระเงิน' &&
             data.ownerId is string &&
             data.ownerId.size() > 0 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.items.size() <= 50 &&
             data.subtotal is number &&
             data.subtotal >= 0 &&
             data.shippingFee is number &&
             data.shippingFee >= 0 &&
             data.discountAmount is number &&
             data.discountAmount >= 0 &&
             data.discountAmount <= data.subtotal &&
             data.totalAmount is number &&
             data.totalAmount >= data.subtotal + data.shippingFee - data.discountAmount - 0.01 &&
             data.totalAmount <= data.subtotal + data.shippingFee - data.discountAmount + 0.01 &&
             (data.get('couponCode', null) == null
               ? data.discountAmount == 0
               : isValidOrderCoupon(orderId)) &&
             data.shippingAddress is string &&
             data.shippingAddress.size() > 0 &&
             data.shippingAddress.size() <= 1000 &&
             data.lockExpiresAt is timestamp &&
             data.lockExpiresAt > request.time &&
             data.lockExpiresAt <= request.time + duration.value(16, 'm');
    }

    // ---------- users ----------
    // ใครก็อ่านโปรไฟล์คนอื่นได้ (เช่น โชว์ชื่อในแชท/ออเดอร์)
    // แต่แก้ไขได้เฉพาะโปรไฟล์ตัวเอง และห้ามเปลี่ยน role ตัวเอง
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------- books ----------
    // ทุกคนอ่านได้ (รวมคนไม่ล็อกอิน เพื่อดูรายการหนังสือก่อนสมัคร)
    // เขียนได้เฉพาะเจ้าของร้าน และต้องเป็นเจ้าของ book นั้นจริง
    match /books/{bookId} {
      allow read: if true;
      allow create: if isShopOwner()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isShopOwner()
                    && resource.data.ownerId == request.auth.uid;

      // ---------- books/{bookId}/volumes ----------
      match /volumes/{volumeId} {
        allow read: if true;
        allow create, delete: if isShopOwner()
                    && get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid;

        // ลูกค้าแก้ได้เฉพาะ reservations/updatedAt โดยแอปจะอัปเดตคู่กับ
        // คำสั่งซื้อใน transaction; สำหรับ production ควรย้ายการจองไป backend.
        allow update: if (
              isShopOwner() &&
              get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid
            ) || (
              isSignedIn() &&
              isValidReservationUpdate()
            );
      }
    }

    // ---------- orders ----------
    // อ่าน/เขียนได้เฉพาะคนที่เกี่ยวข้องกับออเดอร์นั้น (ลูกค้าเจ้าของออเดอร์ หรือเจ้าของร้าน)
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
            (resource.data.customerId == request.auth.uid ||
             resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
            request.resource.data.customerId == request.auth.uid &&
            isValidReservationOrder(orderId);

      // ลูกค้าแก้ไขได้แค่ตอนยังไม่ชำระ (เช่น อัปโหลดสลิป)
      // เจ้าของร้านแก้ไขได้เพื่อเปลี่ยนสถานะ/ยืนยันการชำระ/ใส่เลขพัสดุ
      allow update: if isSignedIn() && (
            (resource.data.customerId == request.auth.uid &&
             resource.data.status in ['รอชำระเงิน', 'รอตรวจสอบสลิป']) ||
            (resource.data.ownerId == request.auth.uid)
          );

      allow delete: if false; // ไม่ลบออเดอร์จริง ใช้สถานะ "ยกเลิก" แทน
    }

    // ---------- coupons ----------
    // Document ID = โค้ดคูปอง จึงอ่านด้วย get ตรงๆ ได้ และสร้างโค้ดซ้ำไม่ได้
    match /coupons/{couponId} {
      allow get: if isSignedIn();
      allow list: if isShopOwner() && resource.data.ownerId == request.auth.uid;
      allow create: if isShopOwner()
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.code == couponId
            && couponId.matches('[A-Z0-9_-]{3,20}')
            && request.resource.data.usedCount == 0;
      // ลูกค้าแก้ได้เฉพาะ reservations (เหมือนการล็อกสต๊อก) ห้ามแตะ usedCount
      allow update: if (isShopOwner() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId)
                    || (isSignedIn() && isValidCouponReservationUpdate());
      allow delete: if isShopOwner() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- chat_rooms ----------
    // roomId = '{customerId}_{ownerId}' จึงตรวจสิทธิ์จาก roomId ได้แม้ห้องยังไม่ถูกสร้าง
    match /chat_rooms/{roomId} {
      allow read, update: if isSignedIn()
            && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
            && request.auth.uid in request.resource.data.participants
            && request.auth.uid in roomId.split('_');
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
            && request.auth.uid in roomId.split('_');
        allow create: if isSignedIn()
            && request.resource.data.senderId == request.auth.uid
            && request.auth.uid in roomId.split('_');
        allow update, delete: if false;
      }
    }
  }
}